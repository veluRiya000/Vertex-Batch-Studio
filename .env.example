# 第一课：把本文件复制为 .env，再填写你自己的配置。
# 这个文件只负责填写配置，不是 Python 代码。
# 注释请单独写一行；相对路径以 VertexBatchStudio/ 为起点。

# 【需要填写】Google Cloud 项目 ID，不是“夏日祭分镜”等批次名称。
GOOGLE_CLOUD_PROJECT=
# 【需要填写】存储桶名称，不包含 gs://，也不包含后面的文件夹路径。
GCS_BUCKET=

# 【暂时保持默认】模型和调用区域。
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.1-flash-image

# 【联网前准备】把自己的凭证文件放到 secrets/key.json。
# 也可以填写密钥的绝对路径。使用 ADC 登录时可清空本项；
# 但如果 secrets/key.json 已存在，程序仍会自动采用该文件。
GOOGLE_APPLICATION_CREDENTIALS=secrets/key.json

# 【可选修改】data 是相对路径，也可以填写外部数据目录的绝对路径。
VBS_DATA_DIR=data
# 后续检查云端任务的间隔，单位为秒，至少为 1。
VBS_POLL_SECONDS=30
