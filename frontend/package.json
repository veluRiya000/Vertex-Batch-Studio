{
  "name": "vertex-batch-studio",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:icons && tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "test": "vitest run",
    "package:win": "tauri build --config src-tauri/tauri.bundle.json --bundles nsis && node scripts/collect-installer.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "description": "Desktop studio for Vertex AI image batches"
}
